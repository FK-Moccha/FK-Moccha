# --- KI-Provider für die Recherche --------------------------------------
# "perplexity" (Standard, empfohlen) oder "anthropic". Nur serverseitig
# gelesen (src/lib/ai/), nie im Client-Bundle.
AI_PROVIDER=perplexity

# --- Perplexity Sonar API (Standard-Provider) ---------------------------
# Erforderlich, wenn AI_PROVIDER=perplexity (oder leer gelassen). Erstelle
# deinen Key unter https://www.perplexity.ai/settings/api — NIEMALS einen
# echten Key hier eintragen oder committen, das hier ist nur die Vorlage!
PERPLEXITY_API_KEY=
# Modell für die Recherche. "sonar" ist das günstigste Sonar-Modell.
PPLX_MODEL=sonar
# Wie viel Web-Kontext pro Anfrage eingekauft wird: "low" | "medium" | "high".
# "low" hält die Kosten pro Reiseplanung minimal.
PPLX_SEARCH_CONTEXT_SIZE=low

# --- Anthropic API (optionaler alternativer Provider) -------------------
# Nur nötig, wenn AI_PROVIDER=anthropic gesetzt ist. Key unter
# https://console.anthropic.com erstellen.
ANTHROPIC_API_KEY=

# --- Datenbank -----------------------------------------------------------
# SQLite-Datei, relativ zum Projekt-Root.
DATABASE_URL="file:./dev.db"

# --- Optionaler Passwortschutz fürs Erstellen neuer Reisen ----------------
# Wenn gesetzt, muss dieses Passwort beim Anlegen einer neuen Reise
# eingegeben werden (die App fragt automatisch danach). Bereits
# gespeicherte/geteilte Reisen bleiben ohne Login einsehbar.
CREATE_TRIP_PASSWORD=
