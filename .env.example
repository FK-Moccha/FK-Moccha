# --- Anthropic API -----------------------------------------------------
# Erforderlich. Nie im Client-Bundle verwenden — nur serverseitig gelesen
# (src/lib/anthropic.ts). Hol dir einen Key unter https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Datenbank -----------------------------------------------------------
# SQLite-Datei, relativ zum Projekt-Root.
DATABASE_URL="file:./dev.db"

# --- Optionaler Passwortschutz fürs Erstellen neuer Reisen ----------------
# Wenn gesetzt, muss dieses Passwort beim Anlegen einer neuen Reise
# eingegeben werden (die App fragt automatisch danach). Bereits
# gespeicherte/geteilte Reisen bleiben ohne Login einsehbar.
CREATE_TRIP_PASSWORD=
